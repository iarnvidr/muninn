"""
Muninn's source-scoped Linux checks. macOS app packaging stays on a native Mac.
"""
type MuninnCi {
  let ws: Workspace!

  new(ws: Workspace!) {
    self.ws = ws
    self
  }

  # Keep the image, target, Rust flags and cache ABI together. Cargo validates
  # dependency fingerprints; changing Cargo.lock does not discard this volume.
  let rustTools: Container! = container(platform: "linux/amd64")
    .from("rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b")

  let nodeTools: Container! = container(platform: "linux/amd64")
    .from("node:22.23.3-bookworm-slim@sha256:3ed98443660ff48413b5af19ecefce3b9d50845a901a43420d47cc63a9fddbe9")

  # This tracked-empty directory is populated by actions/cache on hosted CI.
  # The seed initializes a new volume; the same seed reuses an existing volume.
  # It is deliberately outside the module directory and every source filter.
  let cargoSeed: Directory! {
    ws.directory("/ci/cache/linux-cargo", exclude: [".gitignore"])
  }

  # Dagger v1 includes source and sharing in the cache identity. All readers and
  # writers must use this same seeded object, including the export function.
  let cargoCache: CacheVolume! {
    cacheVolume("muninn-cargo-linux-amd64-rust-1.99.1-bookworm-v1",
      source: cargoSeed, sharing: CacheSharingMode.LOCKED)
  }

  let rustSystem: Container! {
    rustTools
      .withExec(["sh", "-ec", "apt-get update && apt-get install -y --no-install-recommends build-essential rsync pkg-config patchelf libssl-dev libxdo-dev libwebkit2gtk-4.1-dev libsoup-3.0-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev ffmpeg && rm -rf /var/lib/apt/lists/*"])
  }

  # Debian package versions can advance even while the starting image is pinned.
  # Do not reuse native build-script/linker output across different system ABIs.
  let rustSystemABI: String! {
    rustSystem
      .withExec(["bash", "-euc", "set -o pipefail; dpkg-query -W | LC_ALL=C sort | sha256sum | cut -d ' ' -f 1 | tr -d '\\n'"])
      .stdout
  }

  # The same ABI that namespaces Cargo's target dir is used to resolve
  # immutable, separately published crate packages before the check starts.
  pub rustAbi: String! {
    rustSystemABI
  }

  let rustBase: Container! {
    rustSystem
      .withMountedCache("/cache", cargoCache)
      .withEnvVariable("CARGO_HOME", "/cache/cargo")
      .withEnvVariable("CARGO_TARGET_DIR", `/cache/target/${rustSystemABI}`)
      .withEnvVariable("CARGO_INCREMENTAL", "0")
      .withEnvVariable("CARGO_BUILD_JOBS", "2")
      .withFile("/run-rust.sh", ws.file("/ci/dagger/check/run-rust.sh"))
      .withWorkdir("/")
  }

  # Cargo workspace discovery needs all REAL manifests/entrypoints, but it does
  # not need unrelated crate implementations. Build input closures by following
  # local path dependencies. A UI edit therefore changes only ui-assets, server,
  # CLI and desktop checks; a capture edit doesn't invalidate policy tests.
  let workspaceSkeleton: Directory! {
    ws.directory("/", include: [
      "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".cargo/**",
      "core/Cargo.toml", "core/src/lib.rs",
      "crates/*/Cargo.toml", "crates/*/src/lib.rs", "crates/*/src/main.rs",
      "crates/*/src/bin/**",
      "src-tauri/Cargo.toml", "src-tauri/build.rs", "src-tauri/src/main.rs",
      "src-tauri/tauri.conf.json",
    ], exclude: ["**/target", "**/__pycache__", "**/node_modules"])
  }

  let domainSource: Directory! {
    workspaceSkeleton.withDirectory("/crates/domain", ws.directory("/crates/domain"))
  }
  let policySource: Directory! {
    domainSource.withDirectory("/crates/policy", ws.directory("/crates/policy"))
  }
  let captureSource: Directory! {
    domainSource.withDirectory("/crates/capture", ws.directory("/crates/capture"))
  }
  let storageSource: Directory! {
    policySource.withDirectory("/crates/storage", ws.directory("/crates/storage"))
  }
  let mediaSource: Directory! {
    domainSource.withDirectory("/crates/media", ws.directory("/crates/media"))
  }
  let navigationLibSource: Directory! {
    captureSource.withDirectory("/crates/navigation", ws.directory("/crates/navigation"))
  }
  # Navigation's own tests use storage as a dev-dependency. Client builds that
  # merely DEPEND on navigation must not pick up that test-only storage code.
  let navigationSource: Directory! {
    navigationLibSource
      .withDirectory("/crates/policy", ws.directory("/crates/policy"))
      .withDirectory("/crates/storage", ws.directory("/crates/storage"))
  }
  let protocolSource: Directory! {
    domainSource.withDirectory("/crates/protocol", ws.directory("/crates/protocol"))
  }
  let clientSource: Directory! {
    navigationLibSource
      .withDirectory("/crates/protocol", ws.directory("/crates/protocol"))
      .withDirectory("/crates/client", ws.directory("/crates/client"))
  }
  let coreSource: Directory! {
    navigationSource
      .withDirectory("/crates/media", ws.directory("/crates/media"))
      .withDirectory("/core", ws.directory("/core"))
  }
  let uiAssetsSource: Directory! {
    workspaceSkeleton
      .withDirectory("/crates/ui-assets", ws.directory("/crates/ui-assets"))
      .withDirectory("/ui", ws.directory("/ui"))
  }
  let serverSource: Directory! {
    coreSource
      .withDirectory("/crates/protocol", ws.directory("/crates/protocol"))
      .withDirectory("/crates/ui-assets", ws.directory("/crates/ui-assets"))
      .withDirectory("/ui", ws.directory("/ui"))
      .withDirectory("/crates/server", ws.directory("/crates/server"))
  }
  # CLI integration tests have a DEV-dependency on muninn-server.
  let cliSource: Directory! {
    serverSource.withDirectory("/crates/cli", ws.directory("/crates/cli"))
  }
  let desktopSource: Directory! {
    cliSource
      .withDirectory("/crates/client", ws.directory("/crates/client"))
      .withDirectory("/crates/navigation", ws.directory("/crates/navigation"))
      .withDirectory("/src-tauri", ws.directory("/src-tauri", exclude: ["gen", "**/target"]))
      # Tauri generate_context! reads frontendDist relative to src-tauri.
      # This is a build-time source input, not a runtime network dependency.
      .withDirectory("/shell", ws.directory("/shell"))
      .withFile("/LICENSE", ws.file("/LICENSE"))
  }

  # First-class per-crate checks. Dagger reports each independently, and Cargo
  # validates fingerprints on the shared LOCKED volume. A failing crate cannot
  # prevent other check results from being recorded.
  pub domainTests: Void @check {
    rustBase.withMountedDirectory("/input", domainSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "bash", "-euc", "cargo test --locked -p muninn-domain --no-default-features && cargo test --locked -p muninn-domain"])
      .sync
    null
  }
  pub policyTests: Void @check {
    rustBase.withMountedDirectory("/input", policySource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-policy"])
      .sync
    null
  }
  pub captureTests: Void @check {
    rustBase.withMountedDirectory("/input", captureSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-capture"])
      .sync
    null
  }
  pub storageTests: Void @check {
    rustBase.withMountedDirectory("/input", storageSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-storage"])
      .sync
    null
  }
  pub mediaTests: Void @check {
    rustBase.withMountedDirectory("/input", mediaSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-media"])
      .sync
    null
  }
  pub navigationTests: Void @check {
    rustBase.withMountedDirectory("/input", navigationSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-navigation"])
      .sync
    null
  }
  pub protocolTests: Void @check {
    rustBase.withMountedDirectory("/input", protocolSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-protocol"])
      .sync
    null
  }
  pub clientTests: Void @check {
    rustBase.withMountedDirectory("/input", clientSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-client"])
      .sync
    null
  }
  pub coreTests: Void @check {
    rustBase.withMountedDirectory("/input", coreSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-core"])
      .sync
    null
  }
  pub uiAssetsTests: Void @check {
    rustBase.withMountedDirectory("/input", uiAssetsSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-ui-assets"])
      .sync
    null
  }
  pub serverTests: Void @check {
    rustBase.withMountedDirectory("/input", serverSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-server"])
      .sync
    null
  }
  pub cliTests: Void @check {
    rustBase.withMountedDirectory("/input", cliSource)
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn-cli"])
      .sync
    null
  }
  pub desktopTests: Void @check {
    rustBase.withMountedDirectory("/input", desktopSource)
      .withEnvVariable("MUNINN_CARGO_LOG", "/cache/check-logs/desktop-tests.log")
      .withExec(["bash", "/run-rust.sh", "/input", "/cache", "cargo", "test", "--locked", "-p", "muninn"])
      .sync
    null
  }

  """
  Existing injected-page, UI and native-player JavaScript regression tests.
  """
  pub javascript: Void @check {
    nodeTools
      .withMountedDirectory("/src", ws.directory("/", include: [
        "ui/**", "src-tauri/*.js", "src-tauri/test/**",
        "build/native-player-interactions.js", "build/test_native_player_interactions.js",
      ], exclude: ["**/node_modules"]))
      .withWorkdir("/src")
      .withExec(["sh", "-ec", "node --test src-tauri/test/*.test.js ui/test/*.test.js build/test_native_player_interactions.js"])
      .sync
    null
  }

  """
  Packaging, release/provenance, native-smoke wiring and updater-protocol tests.
  Git-history/publication boundary checks run on the host checkout afterwards.
  """
  pub packaging: Void @check {
    container(platform: "linux/amd64")
      .from("python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337")
      .withExec(["sh", "-ec", "apt-get update && apt-get install -y --no-install-recommends bash build-essential git rsync zstd && ln -s /usr/local/bin/python3 /usr/bin/python3 && rm -rf /var/lib/apt/lists/*"])
      .withDirectory("/usr/local/cargo", rustTools.directory("/usr/local/cargo"))
      .withDirectory("/usr/local/rustup", rustTools.directory("/usr/local/rustup"))
      .withFile("/usr/local/bin/node", nodeTools.file("/usr/local/bin/node"))
      .withEnvVariable("CARGO_HOME", "/usr/local/cargo")
      .withEnvVariable("RUSTUP_HOME", "/usr/local/rustup")
      .withEnvVariable("PATH", "/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin")
      .withMountedDirectory("/src", ws.directory("/", include: [
        "build/**", ".github/**", "ci/dagger/**", "dagger.toml",
        "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".cargo/**",
        "core/**", "crates/**", "src-tauri/**", "ui/**",
        "licenses/**", "LICENSE", "THIRD_PARTY_NOTICES.md",
      ], exclude: ["**/target", "**/__pycache__", "**/node_modules", "src-tauri/gen"]))
      .withWorkdir("/src")
      .withExec(["sh", "-ec", "python3 -m unittest discover -s build -p 'test_*.py' -v && python3 -m unittest discover -s ci/dagger/check -p 'test_*.py' -v && python3 build/updater-smoke/test_protocol.py"])
      .sync
    null
  }

  """
  Snapshot Cargo's downloads, source mirror and compiled output for a hosted runner.
  Pass a fresh nonce only here; never add a run ID or commit to the build cache key.
  This does not rerun tests, grant a check success, or produce release evidence.
  """
  pub exportCargoCache(nonce: String!): Directory! {
    rustTools
      .withMountedCache("/cache", cargoCache)
      # Mutable volume contents are not an exec cache key. A nonce on the copying
      # exec prevents an old snapshot being exported after a later Cargo build.
      .withEnvVariable("MUNINN_CACHE_EXPORT_NONCE", nonce)
      .withExec(["sh", "-ec", "mkdir -p /snapshot/cargo /snapshot/target; for part in registry git; do if test -d /cache/cargo/$part; then cp -a /cache/cargo/$part /snapshot/cargo/; fi; done; if test -d /cache/target; then cp -a /cache/target/. /snapshot/target/; fi; if test -d /cache/worktree; then cp -a /cache/worktree /snapshot/; fi; if test -d /cache/check-logs; then cp -a /cache/check-logs /snapshot/; fi"])
      .directory("/snapshot")
  }
}
