{
  "identifier": "chrome",
  "description": "Muninn's own UI page (served by the local server inside this app)",
  "webviews": ["chrome"],
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"] },
  "permissions": [
    "allow-app-boot", "allow-tabs-state", "allow-tab-new", "allow-tab-activate", "allow-tab-close", "allow-tab-go", "allow-tab-back",
    "allow-tab-forward", "allow-tab-reload", "allow-tab-open-video", "allow-tab-hibernate", "allow-layout", "allow-native-visible",
    "allow-open-external", "allow-trust-status", "allow-trust-install", "allow-signin-popup", "allow-e2e-result", "allow-channel-unsubscribe", "allow-export-diagnostics", "allow-updater-status", "allow-updater-check", "allow-updater-install"
  ]
}
